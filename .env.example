# このファイルを .env にコピーして使う（.env は .gitignore 済みのため平文がgitに入らない）

# kabuステーションのAPIシステム設定で発行するAPIパスワード（必須）。
# 証券口座のログインパスワード・取引暗証番号とは別物なので注意（kabuステーション
# アプリの「APIシステム設定」画面で設定したパスワードを使うこと）。
# ※ APIパスワードの平文は .env にのみ置く。スクリプトやconfig.yaml、ドキュメントに
#    値を書き写さないこと（公開リポジトリへ漏洩する）。
KABU_API_PASSWORD=

# 本番系／検証系のAPIパスワード（任意。switch-mode.bat でモードを切り替える場合に使う）。
# kabuステーションは 本番=18080 / 検証=18081 でパスワードも別になるため、両方を登録しておくと
# scripts/switch_mode.ps1 が選択モードに応じて上の KABU_API_PASSWORD へ自動でコピーする。
# 未設定でもモードと接続先の切り替えは動作する（KABU_API_PASSWORD は変更されない）。
KABU_API_PASSWORD_LIVE=
KABU_API_PASSWORD_VERIFY=

# ダッシュボードのアクセストークン（任意）。設定すると認証が有効になる。
# host を 0.0.0.0（LAN公開）にする場合は設定を強く推奨。
KABU_DASHBOARD_TOKEN=

# Discord Webhook URL（任意）。設定すると取引情報（銘柄・数量・価格・損益）がDiscordへ送信される。
# 取得方法は docs/通知設定ガイド.md を参照。
DISCORD_WEBHOOK_URL=

# ─── Discordリモコン（任意）─────────────────────────────────────────
# 外出先から状態確認・緊急停止を行うためのBot。ポート開放は不要（アウトバウンドのみ）。
# 3つすべて設定すると有効になる。未設定なら機能ごと無効（既存挙動と同じ）。
# 設定手順は docs/通知設定ガイド.md を参照。
#
# ※ 秘密情報をDiscordに送らせない方針のため、.envの書き換えやパスワード送信、
#    緊急全決済はコマンドとして実装していない（全決済はダッシュボード限定）。
# ※ BOT_TOKEN は秘密情報。絶対にコミット・共有しないこと。
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=
# 操作を許可する自分のDiscordユーザーID（これ以外の人のコマンドは拒否される）
DISCORD_ALLOWED_USER_ID=

# X（旧Twitter）APIの認証情報（任意）。4つすべて設定し、config.yamlのx.enabledをtrueにすると
# 平日17:30に日次損益サマリが自動投稿される。取得手順は docs/日次レポート投稿ガイド.md を参照。
# Read and Write 権限が必須（権限変更後はAccess Tokenの再生成が必要）。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Discord日次レポート用Webhook URL（任意・無料）。設定し、config.yamlのdiscord_report.enabledを
# trueにすると、X同様の日次損益サマリが平日17:30にDiscordへ自動投稿される。
# 上のDISCORD_WEBHOOK_URL（異常時アラート用）とは別チャンネル想定。同じURLでも構わない。
DISCORD_REPORT_WEBHOOK_URL=
